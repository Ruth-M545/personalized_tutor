# Django settings
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Either use DATABASE_URL or set DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, DB_PORT
# DATABASE_URL=postgres://tutor:tutor@db:5432/tutor_db
DB_HOST=localhost
DB_NAME=tutor_db
DB_USER=tutor
DB_PASSWORD=tutor
DB_PORT=5432

# Redis (for Channels and Celery)
REDIS_URL=redis://127.0.0.1:6379/0

# LLM provider
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
OPENAI_API_KEY=your_openai_key_here

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Tutor <noreply@tutor.com>"

# Optional runtime settings
MAX_CONTEXT_MESSAGES=20
STREAMING_ENABLED=True
